--------------------------------------------------------------------
-- Current version of the DB is the highest value of filename
-- in the folder `sqldelight/databases`.
--
-- When upgrading the schema, you have to create a file .sqm in the
-- `sqldelight/databases` folder and run the following task to
-- generate a .db file using the latest schema
-- > ./gradlew generateDebugClientSessionDataSchema
--------------------------------------------------------------------

CREATE TABLE ClientSessionData (
    clientId TEXT NOT NULL PRIMARY KEY,           -- was userId
    deviceId TEXT NOT NULL,
    accessToken TEXT NOT NULL,
    refreshToken TEXT,
    clientServerUrl TEXT NOT NULL,                -- was homeserverUrl
    slidingSyncProxy TEXT,
    loginTimestamp INTEGER,
    oidcData TEXT,
    isTokenValid INTEGER NOT NULL DEFAULT 1,
    gsnLoginType TEXT,                            -- was loginType
    securityPhase TEXT,                           -- was passphrase
    clientSessionPath TEXT NOT NULL DEFAULT "",   -- was sessionPath
    cachePath TEXT NOT NULL DEFAULT ""
);

selectFirst:
SELECT * FROM ClientSessionData LIMIT 1;

selectAll:
SELECT * FROM ClientSessionData;

selectByUserId:
SELECT * FROM ClientSessionData WHERE clientId = ?;  -- was userId

insertSessionData:
INSERT INTO ClientSessionData VALUES ?;

removeSession:
DELETE FROM ClientSessionData WHERE clientId = ?;    -- was userId

updateSession:
REPLACE INTO ClientSessionData VALUES ?;
